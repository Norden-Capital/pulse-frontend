# Copy this file to `.env.local` and adjust. Never commit real values.
# Both variables are server-side only: NEVER prefix them with NEXT_PUBLIC_.

# Address of the backend API, reachable from the machine running Next.js.
# Local backend: http://localhost:8080. On Vercel it is set in the project
# settings (Production only).
BACKEND_URL=http://localhost:8080

# Shared secret sent as X-Pulse-Proxy-Secret; the backend refuses /api calls
# without it. Same value as the backend's APP_PROXY_SECRET. Required in
# production (missing = 503); may stay empty for a local backend, whose check
# is off. Set on Vercel as a Sensitive variable; never type or print it.
PULSE_PROXY_SECRET=
